<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@85..125,400..800&display=swap">
  <style>
    body { margin: 0; background: #EFEFEA; }
    a { color: #CE3118; } a:hover { color: #A32712; }
    .app { width: 390px; height: 844px; background: #EFEFEA; color: #17171C; overflow: hidden;
      font-family: 'Archivo', ui-rounded, -apple-system, 'Helvetica Neue', system-ui, sans-serif;
      font-variant-numeric: tabular-nums; font-feature-settings: 'tnum' 1;
      display: flex; flex-direction: column; }
    .nano { font-size: 9.5px; font-weight: 800; letter-spacing: .186em; line-height: 12px; text-transform: uppercase; }
    .row { display: flex; align-items: stretch; flex: none; position: relative; z-index: 1; }
    .gut { width: 52px; flex: none; text-align: right; padding-right: 12px; color: #6B6B63; }
    .bd { flex: 1; min-width: 0; display: flex; align-items: center; padding-left: 12px; padding-right: 20px; overflow: hidden; }
    .nm { font-size: 15px; font-weight: 700; letter-spacing: -.0141em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .q { font-size: 13px; font-weight: 650; letter-spacing: -.0124em; margin-left: auto; flex: none; }
    .q i { font-style: normal; font-size: .62em; opacity: .45; padding-left: 1px; }
    .hero { font-size: 52px; font-weight: 800; font-stretch: 112%; letter-spacing: -.0431em; line-height: 44px; }
    .hero i { font-style: normal; font-size: .42em; opacity: .42; }
    .queue { position: relative; flex: none; }
  </style>
</helmet>
